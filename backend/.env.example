# Copy to ".env". Never commit .env.
BQ_PROJECT=nodal-plexus-492111-e9
BQ_DATASET=warehouse_llc

# Hard ceiling on bytes a single query may bill (10 GB).
# An oversized query FAILS instead of costing money.
BQ_MAX_BYTES_BILLED=10000000000

FRONTEND_ORIGIN=http://localhost:3000

# Cloud deployment (Render / Railway etc.)
# Paste the ENTIRE contents of your GCP service-account JSON here (one line).
# Leave empty when running locally with: gcloud auth application-default login
GOOGLE_CREDENTIALS_JSON=
